{
  "name": "student-diary",
  "version": "1.1.0",
  "description": "Ecampus: успеваемость, мои курсы и личный дневник студента",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "keywords": [],
  "author": "Student",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "productName": "Ecampus",
  "build": {
    "appId": "local.student.diary",
    "productName": "Ecampus",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "Дневник-студента-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Ecampus.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
